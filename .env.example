# Optional AI review. Without a key, all static analysis still works.
CODESENTINEL_AI_API_KEY=
CODESENTINEL_AI_BASE_URL=https://api.openai.com/v1
CODESENTINEL_AI_MODEL=gpt-4o-mini

# Optional local service settings.
CODESENTINEL_API_HOST=127.0.0.1
CODESENTINEL_API_PORT=8000
CODESENTINEL_UI_HOST=127.0.0.1
CODESENTINEL_UI_PORT=8501
CODESENTINEL_API_URL=http://127.0.0.1:8000# Optional. Leave this empty to run static analysis only.
# The key is read by the backend and is never shown in the dashboard or logs.
CODESENTINEL_LLM_API_KEY=

# OpenAI-compatible chat endpoint. Do not put the key in this URL.
CODESENTINEL_LLM_BASE_URL=https://api.openai.com/v1
CODESENTINEL_LLM_MODEL=gpt-4o-mini

# OPENAI_API_KEY is used only when CODESENTINEL_LLM_API_KEY is empty.
OPENAI_API_KEY=
